{
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "nodenext",
    "target": "ESNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist/"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
